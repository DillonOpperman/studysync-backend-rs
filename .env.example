# Copy this file to `.env` and replace placeholders.
# Never commit `.env`.

# PostgreSQL (Docker Compose service `postgres`)
DATABASE_URL=postgres://studysync:studysync_dev_only_change_me@127.0.0.1:5432/studysync?sslmode=disable

# Redis (present in Compose; not required for `cargo test`)
REDIS_URL=redis://127.0.0.1:6379

# JWT secret — required at startup; unused until Phase 2.
# Must be at least 32 characters. Generate a unique value for every environment.
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars

# Public URL used later for media links. No hardcoded emulator hosts.
PUBLIC_BASE_URL=http://127.0.0.1:8080

SERVER_HOST=0.0.0.0
SERVER_PORT=8080

RUST_LOG=info,tower_http=info,studysync_backend=info

# Optional pool tuning (defaults are used if omitted)
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=1
# DATABASE_ACQUIRE_TIMEOUT_SECS=8
# DATABASE_IDLE_TIMEOUT_SECS=600
# DATABASE_MAX_LIFETIME_SECS=1800

# Compose infrastructure only (MinIO). Not read by the Phase 1 Rust process.
POSTGRES_USER=studysync
POSTGRES_PASSWORD=studysync_dev_only_change_me
POSTGRES_DB=studysync

MINIO_ROOT_USER=studysync
MINIO_ROOT_PASSWORD=studysync_dev_minio_change_me
MINIO_BUCKET=studysync-media

# Object storage (S3-compatible). Omit S3_ENDPOINT in unit tests to use in-memory storage.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=studysync-media
S3_ACCESS_KEY=studysync
S3_SECRET_KEY=studysync_dev_minio_change_me
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_BYTES=10485760
MEDIA_SIGNED_URL_TTL_SECS=300

# Embedding backend: hash (dev/test stand-in at Qwen 1024-d) or unavailable (semantic 503).
# Official Qwen/Qwen3-Embedding-0.6B weights are not stored in git. Pin revision
# c935f2d3fce3e2337b4a66ac3130faa6dada3218 when loading at deploy time.
EMBEDDING_BACKEND=hash
